# Never commit the real .env file.
HELIUS_API_KEY=
HELIUS_RPC_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Standard Solana JSON-RPC read providers. Blank URLs are disabled. Public RPC
# is an emergency fallback and defaults to mainnet-beta when omitted.
ALCHEMY_SOLANA_RPC_URL=
CHAINSTACK_SOLANA_RPC_URL=
ANKR_SOLANA_RPC_URL=
SOLANA_PUBLIC_RPC_URL=https://api.mainnet.solana.com

# Conservative per-provider process-shared start rates.
ALCHEMY_RPC_MAX_RPS=3
CHAINSTACK_RPC_MAX_RPS=3
ANKR_RPC_MAX_RPS=5
HELIUS_RPC_MAX_RPS=8
SOLANA_PUBLIC_RPC_MAX_RPS=2
SOLANA_RPC_PROVIDER_ATTEMPTS=2
SOLANA_RPC_OVERALL_ATTEMPT_BUDGET=6

# Start in simulation mode. Explicitly change only after execution safeguards exist.
TRADING_MODE=paper
# Fernet ciphertext only. Keep SOLANA_KEY_ENCRYPTION_KEY in the OS/service
# secret store, never in this file.
SOLANA_PRIVATE_KEY_ENCRYPTED=
JUPITER_API_KEY=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
EXPECTED_LIVE_WALLET_ADDRESS=
# Leave blank in paper mode. Exact phrase required for live mode.
LIVE_TRADING_ACK=

# wallet_feeder.py safety/selection settings
WALLET_REFRESH_HOURS=1
WALLET_MAX_WALLETS=20
# monitor.py checks for an atomically replaced wallets.json at this interval.
WALLET_RELOAD_SECONDS=5
WALLET_MIN_SOL_BALANCE=0.1
WALLET_MAX_DAILY_TX=300
WALLET_SIGNATURES_PER_PROGRAM=50
WALLET_MAX_CANDIDATES=250
WALLET_RPC_MIN_INTERVAL_SECONDS=0.3

# Minimum observation window before any future copy-trade executor may act.
COPY_TRADE_DELAY_SECONDS=5

# Dashboard access. Replace both values before exposing the service publicly.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me
# Use a long random value. Changing it logs out all existing dashboard sessions.
DASHBOARD_SESSION_SECRET=replace_with_a_long_random_secret
# Set true behind HTTPS on the VPS. Keep false only for local http:// testing.
DASHBOARD_COOKIE_SECURE=false
